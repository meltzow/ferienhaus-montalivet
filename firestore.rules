rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /houseContent/{documentId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && documentId == 'main'
        && request.resource.data.keys().hasOnly([
          'houseName',
          'ownerWhatsApp',
          'wasteScheduleYear',
          'topics',
          'departureChecklist',
          'departureUpdatedAt',
          'lastUpdated',
          'schemaVersion',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.houseName is string
        && request.resource.data.ownerWhatsApp is string
        && request.resource.data.wasteScheduleYear is int
        && request.resource.data.topics is list
        && request.resource.data.departureChecklist is list
        && request.resource.data.departureUpdatedAt is string
        && request.resource.data.lastUpdated is string
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /wastePickups/{pickupDate} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'date',
          'label',
          'message',
          'enabled',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.date == pickupDate
        && request.resource.data.date is string
        && request.resource.data.label is string
        && request.resource.data.message is string
        && request.resource.data.enabled is bool
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /reminderRegistrations/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'installationId',
          'enabled',
          'departureDate',
          'timezone',
          'locale',
          'lastSeenAt',
          'lastReminderKey',
          'lastReminderAt'
        ])
        && request.resource.data.installationId is string
        && request.resource.data.enabled is bool
        && request.resource.data.departureDate is string
        && request.resource.data.timezone is string
        && request.resource.data.locale is string;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
    }
  }
}
